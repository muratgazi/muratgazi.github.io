---
import Base from '../../layouts/Base.astro';
import { tumHaberler, slug } from '../../data/haberler';

export function getStaticPaths() {
  return tumHaberler.map((haber) => ({ params: { slug: slug(haber.baslik) }, props: { haber } }));
}
const { haber } = Astro.props;
const arka = `background:linear-gradient(135deg,${haber.renk[0]},${haber.renk[1]});display:flex;align-items:center;justify-content:center;font-size:4rem;`;
---
<Base baslik={`${haber.baslik} | HABER SAV`}>
  <article class="kap okuma">
    <div class="gorsel" style={arka} role="img" aria-label="Haber için üretilmiş grafik">{haber.ikon}</div>
    <p class="etiket"><a href={`/kategori/${slug(haber.kategori)}/`}>{haber.kategori}</a></p>
    <h1>{haber.baslik}</h1>
    <p class="ozet">{haber.ozet}</p>
    <p class="ozet" style="color:var(--gri);font-size:0.95rem">Kaynak: {haber.kaynak}. Demo sürümü, kısa özet.</p>
    <a class="geri" href="/">← Ana sayfaya dön</a>
  </article>
</Base>
