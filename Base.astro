---
import '../styles/global.css';
import { kategoriler, slug } from '../data/haberler';

interface Props {
  baslik?: string;
}
const { baslik = 'HABER SAV' } = Astro.props;
const tarih = new Date().toLocaleDateString('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  weekday: 'long',
  timeZone: 'Europe/Istanbul',
});
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Türkiye'nin uluslararası medyada yansıması." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{baslik}</title>
  </head>
  <body>
    <header class="ust" style="background:#000">
      <div class="kap ust-ic" style="padding-top:10px;padding-bottom:10px">
        <a class="logo" href="/" aria-label="HABER SAV ana sayfa">
          <img src="/logo.png" alt="HABER SAV" style="height:96px;width:auto;display:block" />
        </a>
        <time class="tarih">{tarih}</time>
      </div>
      <nav class="menu" aria-label="Kategoriler">
        <ul class="kap">
          {kategoriler.map((k) => (
            <li><a href={`/kategori/${slug(k)}/`}>{k}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="alt">
      <div class="kap">
        <p>HABER SAV, MAN Sportif Faaliyetler Ltd. Şti. tarafından yayınlanır.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .son-dakika ul, .menu ul { scrollbar-width: none; }
  .son-dakika ul::-webkit-scrollbar, .menu ul::-webkit-scrollbar { display: none; }
  .okuma { max-width: 760px; padding-top: 28px; padding-bottom: 48px; }
  .okuma h1 { font-size: 2rem; margin: 8px 0 14px; }
  .okuma .ozet { color: var(--beyaz); font-size: 1.1rem; max-width: none; }
  .geri { display: inline-block; margin-top: 20px; color: var(--yesil); }
</style>
