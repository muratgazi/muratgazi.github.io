---
import Base from '../layouts/Base.astro';
import { manset, yanHaberler, sonDakika, bolumler, yazarlar, slug } from '../data/haberler';
const arka = (h: { renk: [string, string] }) =>
  `background:linear-gradient(135deg,${h.renk[0]},${h.renk[1]});display:flex;align-items:center;justify-content:center;font-size:3.2rem;`;
---
<Base baslik="HABER SAV | Türkiye'nin uluslararası medyada yansıması">
  <div class="son-dakika">
    <div class="kap">
      <strong>Son dakika</strong>
      <ul>
        {sonDakika.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>

  <section class="kap ust-bolum">
    <article class="manset">
      <div class="gorsel" style={arka(manset)} role="img" aria-label="Manşet için üretilmiş grafik">{manset.ikon}</div>
      <p class="etiket">{manset.kategori}</p>
      <h1><a href={`/haber/${slug(manset.baslik)}/`}>{manset.baslik}</a></h1>
      <p class="ozet">{manset.ozet}</p>
      <p class="ozet">Kaynak: {manset.kaynak}</p>
    </article>
    <aside class="yan">
      <h2>Öne çıkanlar</h2>
      <ul>
        {yanHaberler.map((h) => (
          <li>
            <p class="etiket">{h.kategori}</p>
            <a href={`/haber/${slug(h.baslik)}/`}>{h.baslik}</a>
            <p class="ozet">Kaynak: {h.kaynak}</p>
          </li>
        ))}
      </ul>
    </aside>
  </section>

  {bolumler.map((b) => (
    <section class="kap bolum">
      <h2 class="bolum-baslik">{b.ad}</h2>
      <div class="kartlar">
        {b.haberler.map((h) => (
          <article class="kart">
            <div class="gorsel kucuk" style={arka(h)} role="img" aria-label="Haber için üretilmiş grafik">{h.ikon}</div>
            <h3><a href={`/haber/${slug(h.baslik)}/`}>{h.baslik}</a></h3>
            <p>{h.ozet}</p>
            <p>Kaynak: {h.kaynak}</p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="kap bolum">
    <h2 class="bolum-baslik">Köşe yazıları</h2>
    <div class="yazarlar">
      {yazarlar.map((y) => (
        <article class="yazar">
          <div class="avatar" aria-hidden="true"></div>
          <h3>{y.ad}</h3>
          <a href="#">{y.konu}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="kap bolum">
    <p class="ozet">Demo sürümü: 25 Ekim 2026 tarihli haberlerin kısa özetleri, kaynakları belirtilerek derlenmiştir. Görseller otomatik üretilmiş grafiklerdir.</p>
  </section>
</Base>
